# PostgreSQL connection string. The compose file maps Postgres to host port 5439.
DATABASE_URL=postgres://app:app@localhost:5439/app

# 32+ byte secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# Public origin of the app. Used to build links in emails and for CSRF checks.
APP_URL=http://localhost:3000

# SMTP (Mailhog in development). The compose file maps Mailhog to host ports
# 1026 (SMTP) and 8026 (web UI at http://localhost:8026).
MAIL_HOST=localhost
MAIL_PORT=1026
MAIL_FROM="TaskFlow <no-reply@taskflow.dev>"

# Set to "1" to run behind HTTPS so the session cookie gets the Secure flag.
# Leave empty in local development.
COOKIE_SECURE=
